{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authz-sandbox",
  "account_id": "9a93e379d73896df4f9234ac783ad6cb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // D1 Database（ローカル用。リモート本番 DB / Worker は削除済み — 再デプロイしない）
  // リモートにデプロイする場合は `wrangler d1 create authz-sandbox` で database_id を取得して差し替え
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authz-sandbox",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/rdb/migrations"
    }
  ],

  // JWT_SECRET は .dev.vars（ローカル）で注入
  "secrets": {
    "required": ["JWT_SECRET"]
  },

  // E2E は vitest の bindings で SEED_CUSTOMER_COUNT を上書きして短時間に抑える
  "vars": {
    "SEED_CUSTOMER_COUNT": "100000"
  }
}
